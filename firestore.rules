rules_version = '2';

// Travel Mission Firestore 보안 규칙
//
// 원칙
//  - 읽기: 로그인 사용자에게 허용(미션은 게스트도 읽음). 앱이 클라이언트에서 목록/랭킹을 구성한다.
//  - 쓰기: 소유권과 문서 형태를 강제한다. 관리자 전용 컬렉션은 admins/{uid} 문서로 판정한다.
//  - 한계: 서버(Cloud Functions)가 없어 포인트 지급/회수의 값 자체는 검증하지 못한다.
//    이 부분의 서버측 검증은 향후 과제다. (보고서 10장)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // 관리자 명단: 로그인 사용자는 본인 관리자 여부를 확인할 수 있고, 목록/수정은 관리자만.
    match /admins/{uid} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 미션: 게스트 포함 누구나 읽기. 삭제/일반 수정은 관리자만.
    // 예외 1: 로그인 사용자는 completionCount/likeCount/bookmarkCount 필드만 바꿀 수 있다
    //   (미션 완료·좋아요·찜 시 인기도 신호 갱신). completionCount 와 마찬가지로 서버 검증이 없어
    //   값 자체의 위조까지는 막지 못한다(10장 한계, 기존과 동일한 신뢰 모델).
    // 예외 2: 로그인 사용자는 본인이 제안자(creatorId)인 미션을 pending 상태·points=0 으로 생성할 수
    //   있다 — 포인트는 관리자가 검수 승인 시에만 정할 수 있다.
    // 예외 3: 제안자는 관리자가 "수정 요청"(changes_requested)한 자신의 미션을 pending 으로
    //   되돌리며(=재제출) 수정할 수 있다. 이때도 points/creatorId 는 못 바꾸고, 카운터 필드도 못 건든다.
    match /missions/{missionId} {
      allow read: if true;
      allow create: if isAdmin()
        || (signedIn()
            && request.resource.data.creatorId == request.auth.uid
            && request.resource.data.reviewStatus == 'pending'
            && request.resource.data.points == 0);
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && onlyChanged(['completionCount', 'likeCount', 'bookmarkCount']))
        || (signedIn()
            && resource.data.creatorId == request.auth.uid
            && resource.data.reviewStatus == 'changes_requested'
            && request.resource.data.reviewStatus == 'pending'
            && request.resource.data.points == resource.data.points
            && request.resource.data.creatorId == resource.data.creatorId
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['likeCount', 'bookmarkCount', 'completionCount']));
    }

    // 미션 좋아요: 공개 반응이라 누구나 읽을 수 있다. 문서 ID를 "{uid}_{missionId}" 로 고정해
    // 사용자당 미션당 최대 1건만 만들 수 있게 강제한다(중복 좋아요 방지). 취소는 본인 문서 삭제.
    match /mission_likes/{likeId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.missionId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // 미션 찜: 개인적인 저장이라 본인만 읽는다. 좋아요와 같은 방식으로 중복을 방지한다.
    match /mission_bookmarks/{bookmarkId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && bookmarkId == request.auth.uid + '_' + request.resource.data.missionId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // 사용자 프로필: 로그인 사용자는 읽기. 본인 또는 관리자만 생성/수정. 삭제 불가.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if false;
    }

    // 미션 진행 상태: 로그인 사용자는 읽기(앱이 userId 로 질의). 생성은 본인 문서만.
    // 수정은 본인 또는 관리자. 삭제는 관리자만.
    //
    // (예전에는 사용자가 자기 photoNeedsReview 를 true→false 로 못 되돌리게 막아 관리자 승인을
    // 우회하지 못하게 했었다. 하지만 검수 대기 중 재촬영해 AI가 이번엔 자동 PASS를 낸 정상 흐름도
    // 똑같은 모양의 쓰기라 함께 막혀버렸다 — 서버 없이는 "진짜 재판정"과 "임의 조작"을 규칙만으로
    // 구분할 수 없으므로(3.6/10장 한계) 이 조건은 제거했다.)
    match /user_missions/{docId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
