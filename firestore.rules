rules_version = '2';

// Travel Mission Firestore 보안 규칙
//
// 원칙
//  - 읽기: 로그인 사용자에게 허용(미션은 게스트도 읽음). 앱이 클라이언트에서 목록/랭킹을 구성한다.
//  - 쓰기: 소유권과 문서 형태를 강제한다. 관리자 전용 컬렉션은 admins/{uid} 문서로 판정한다.
//  - 한계: 서버(Cloud Functions)가 없어 포인트 지급/회수의 값 자체는 검증하지 못한다.
//    이 부분의 서버측 검증은 향후 과제다. (보고서 10장)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // 관리자 명단: 로그인 사용자는 본인 관리자 여부를 확인할 수 있고, 목록/수정은 관리자만.
    match /admins/{uid} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 미션: 게스트 포함 누구나 읽기. 생성/삭제/일반 수정은 관리자만.
    // 예외: 로그인 사용자는 completionCount 필드만 바꿀 수 있다(미션 완료 시 인기도 신호 갱신).
    match /missions/{missionId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && onlyChanged(['completionCount']));
    }

    // 사용자 프로필: 로그인 사용자는 읽기. 본인 또는 관리자만 생성/수정. 삭제 불가.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if false;
    }

    // 미션 진행 상태: 로그인 사용자는 읽기(앱이 userId 로 질의). 생성은 본인 문서만.
    // 수정은 본인 또는 관리자. 단, 사용자는 자기 photoNeedsReview 를 true → false 로 되돌릴 수 없다
    // (검수 승인은 관리자만). 삭제는 관리자만.
    match /user_missions/{docId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && !(
            resource.data.get('photoNeedsReview', false) == true
            && request.resource.data.get('photoNeedsReview', false) == false
          )
        );
      allow delete: if isAdmin();
    }
  }
}
